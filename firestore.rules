rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'mgstudy45@gmail.com';
    }

    // Connection Healthcheck
    match /test/connection {
      allow read: if true;
    }

    // Schools Collection
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // User Profiles with tenant isolation
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Study Notes / Transcriptions (accessible to all students & educators)
    match /study_notes/{noteId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Study Progress - ABAC isolated by userId
    match /study_progress/{progressId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // Bookmarks & Saved items - ABAC isolated by userId
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
    }
  }
}
